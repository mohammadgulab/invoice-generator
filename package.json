{
  "name": "invoice-generator",
  "version": "1.0.0",
  "description": "Create clients and invoices in a clean web form and download professional A4 PDF invoices with VAT. Node.js, Express, SQLite and PDFKit.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "seed": "node src/seed.js"
  },
  "keywords": [
    "invoice",
    "pdf",
    "pdfkit",
    "express",
    "nodejs",
    "sqlite",
    "vat",
    "billing"
  ],
  "author": "Mohammad Gulab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammadgulab/invoice-generator"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "pdfkit": "^0.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
